diff --git a/etc/init/keystore2.rc b/etc/init/keystore2.rc
index 71c39ef..ddb933a 100644
--- a/etc/init/keystore2.rc
+++ b/etc/init/keystore2.rc
@@ -16,6 +16,8 @@ service keystore2 /system/bin/keystore2 /tmp/misc/keystore
     task_profiles ProcessCapacityHigh
     # The default memlock limit of 65536 bytes is too low for keystore.
     rlimit memlock unlimited unlimited
-    # Reboot to bootloader if Keystore crashes more than 4 times before `sys.boot_completed`.
-    critical window=0
+    # Not critical in recovery: sys.boot_completed is never set here, so a
+    # keystore2 crash loop (e.g. a KeyMint problem) would otherwise reboot the
+    # device into the bootloader and take every other recovery feature down
+    # with it. init simply restarts the service instead.
     seclabel u:r:recovery:s0
