 #define MODULE_BASE_DIR "/lib/modules"
+
+// Recovery must stay reachable even when the boot partition carries a kernel
+// that some of vendor_boot's recovery modules do not match (e.g. a custom
+// kernel: a mismatching module fails with ENOEXEC). Instead of aborting on the
+// first failure (parallel loading also stops launching the remaining
+// modules), load everything that can be loaded, one by one, and keep going.
+// Normal and charger boots are unchanged.
+static bool RetryModulesForRecovery(Modprobe& m, const std::string& dir) {
+    LOG(ERROR) << "Some kernel modules in " << dir
+               << " failed to load; recovery boot: loading the remaining ones individually";
+    if (!m.LoadListedModules(false)) {
+        LOG(ERROR) << "Recovery boot continues without the modules that failed to load above";
+    }
+    return true;
+}
