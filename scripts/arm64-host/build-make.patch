diff --git a/core/clang/HOST_arm64.mk b/core/clang/HOST_arm64.mk
new file mode 100644
index 0000000..5f3727c
--- /dev/null
+++ b/core/clang/HOST_arm64.mk
@@ -0,0 +1,5 @@
+# aarch64 Linux host: Soong builds host modules against musl
+# (aarch64-unknown-linux-musl), whose compiler-rt lives in the per-target
+# runtime directory of the linux-arm64 clang prebuilt.
+HOST_LIBPROFILE_RT := $(LLVM_PREBUILTS_BASE)/linux-arm64/$(LLVM_PREBUILTS_VERSION)/lib/clang/$(LLVM_RELEASE_VERSION)/lib/aarch64-unknown-linux-musl/libclang_rt.profile.a
+HOST_LIBCRT_BUILTINS := $(LLVM_PREBUILTS_BASE)/linux-arm64/$(LLVM_PREBUILTS_VERSION)/lib/clang/$(LLVM_RELEASE_VERSION)/lib/aarch64-unknown-linux-musl/libclang_rt.builtins.a
diff --git a/core/envsetup.mk b/core/envsetup.mk
index f82e861..d644057 100644
--- a/core/envsetup.mk
+++ b/core/envsetup.mk
@@ -143,7 +143,8 @@ endif
 BUILD_OS := $(HOST_OS)
 
 # We can do the cross-build only on Linux
-ifeq ($(HOST_OS),linux)
+# (and only on x86_64 Linux: the Windows cross toolchain is x86 only)
+ifeq ($(HOST_OS)$(findstring aarch64,$(UNAME)),linux)
   # Windows has been the default host_cross OS
   ifeq (,$(filter-out windows,$(HOST_CROSS_OS)))
     # We can only create static host binaries for Linux, so if static host
@@ -176,6 +177,13 @@ ifneq (,$(findstring x86_64,$(UNAME)))
   HOST_ARCH := x86_64
   HOST_2ND_ARCH := x86
   HOST_IS_64_BIT := true
+else ifneq (,$(findstring aarch64,$(UNAME)))
+  # aarch64 Linux host. Soong always targets musl on arm64 hosts; say so to
+  # Make too so both agree on out/host/linux-arm64 and the musl host flags.
+  HOST_ARCH := arm64
+  HOST_2ND_ARCH :=
+  HOST_IS_64_BIT := true
+  USE_HOST_MUSL := true
 else
 ifneq (,$(findstring i686,$(UNAME))$(findstring x86,$(UNAME)))
 $(error Building on a 32-bit x86 host is not supported: $(UNAME)!)
@@ -245,7 +253,11 @@ endif
 endif
 
 # We don't want to move all the prebuilt host tools to a $(HOST_OS)-x86_64 dir.
+ifeq ($(HOST_ARCH),arm64)
+HOST_PREBUILT_ARCH := arm64
+else
 HOST_PREBUILT_ARCH := x86
+endif
 # This is the standard way to name a directory containing prebuilt host
 # objects. E.g., prebuilt/$(HOST_PREBUILT_TAG)/cc
 # This must match the logic in get_host_prebuilt_prefix in envsetup.sh
diff --git a/envsetup.sh b/envsetup.sh
index 069c02b..3b74d9f 100644
--- a/envsetup.sh
+++ b/envsetup.sh
@@ -132,7 +132,9 @@ function _get_build_var_cached()
 function get_host_prebuilt_prefix
 {
   local un=$(uname)
-  if [[ $un == "Linux" ]] ; then
+  if [[ $un == "Linux" && $(uname -m) == "aarch64" ]] ; then
+    echo linux-arm64
+  elif [[ $un == "Linux" ]] ; then
     echo linux-x86
   elif [[ $un == "Darwin" ]] ; then
     echo darwin-x86
