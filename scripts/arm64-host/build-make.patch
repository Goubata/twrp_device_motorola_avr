diff --git a/core/envsetup.mk b/core/envsetup.mk
index f82e861..c30c3c3 100644
--- a/core/envsetup.mk
+++ b/core/envsetup.mk
@@ -143,7 +143,8 @@ endif
 BUILD_OS := $(HOST_OS)
 
 # We can do the cross-build only on Linux
-ifeq ($(HOST_OS),linux)
+# (and only on x86_64 Linux: the Windows cross toolchain is x86 only)
+ifeq ($(HOST_OS)$(findstring aarch64,$(UNAME)),linux)
   # Windows has been the default host_cross OS
   ifeq (,$(filter-out windows,$(HOST_CROSS_OS)))
     # We can only create static host binaries for Linux, so if static host
@@ -176,6 +177,11 @@ ifneq (,$(findstring x86_64,$(UNAME)))
   HOST_ARCH := x86_64
   HOST_2ND_ARCH := x86
   HOST_IS_64_BIT := true
+else ifneq (,$(findstring aarch64,$(UNAME)))
+  # aarch64 Linux host (Soong builds host tools for linux_musl-arm64)
+  HOST_ARCH := arm64
+  HOST_2ND_ARCH :=
+  HOST_IS_64_BIT := true
 else
 ifneq (,$(findstring i686,$(UNAME))$(findstring x86,$(UNAME)))
 $(error Building on a 32-bit x86 host is not supported: $(UNAME)!)
@@ -245,7 +251,11 @@ endif
 endif
 
 # We don't want to move all the prebuilt host tools to a $(HOST_OS)-x86_64 dir.
+ifeq ($(HOST_ARCH),arm64)
+HOST_PREBUILT_ARCH := arm64
+else
 HOST_PREBUILT_ARCH := x86
+endif
 # This is the standard way to name a directory containing prebuilt host
 # objects. E.g., prebuilt/$(HOST_PREBUILT_TAG)/cc
 # This must match the logic in get_host_prebuilt_prefix in envsetup.sh
diff --git a/envsetup.sh b/envsetup.sh
index 069c02b..3b74d9f 100644
--- a/envsetup.sh
+++ b/envsetup.sh
@@ -132,7 +132,9 @@ function _get_build_var_cached()
 function get_host_prebuilt_prefix
 {
   local un=$(uname)
-  if [[ $un == "Linux" ]] ; then
+  if [[ $un == "Linux" && $(uname -m) == "aarch64" ]] ; then
+    echo linux-arm64
+  elif [[ $un == "Linux" ]] ; then
     echo linux-x86
   elif [[ $un == "Darwin" ]] ; then
     echo darwin-x86
